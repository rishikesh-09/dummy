// Shopify Client Service
export const shopifyClient = {
  async createCart() {
    try {
      const response = await request(
        SHOPIFY_STOREFRONT_API_URL, 
        CART_CREATE_MUTATION,
        { input: {} },
        { 'X-Shopify-Storefront-Access-Token': SHOPIFY_STOREFRONT_ACCESS_TOKEN }
      )
      return response.cartCreate.cart
    } catch (error) {
      console.error('Error creating cart:', error)
      throw error
    }
  },

  async addToCart(cartId, variantId, quantity = 1) {
    try {
      const response = await request(
        SHOPIFY_STOREFRONT_API_URL,
        CART_LINES_ADD_MUTATION,
        { 
          cartId, 
          lines: [{ 
            merchandiseId: variantId, 
            quantity 
          }] 
        },
        { 'X-Shopify-Storefront-Access-Token': SHOPIFY_STOREFRONT_ACCESS_TOKEN }
      )
      return response.cartLinesAdd.cart
    } catch (error) {
      console.error('Error adding to cart:', error)
      throw error
    }
  },

  async removeFromCart(cartId, lineId) {
    try {
      const response = await request(
        SHOPIFY_STOREFRONT_API_URL,
        CART_LINES_REMOVE_MUTATION,
        { 
          cartId, 
          lineIds: [lineId] 
        },
        { 'X-Shopify-Storefront-Access-Token': SHOPIFY_STOREFRONT_ACCESS_TOKEN }
      )
      return response.cartLinesRemove.cart
    } catch (error) {
      console.error('Error removing from cart:', error)
      throw error
    }
  },

  async updateCartItemQuantity(cartId, lineId, quantity) {
    try {
      const response = await request(
        SHOPIFY_STOREFRONT_API_URL,
        CART_LINES_UPDATE_MUTATION,
        { 
          cartId, 
          lines: [{ 
            id: lineId, 
            quantity 
          }] 
        },
        { 'X-Shopify-Storefront-Access-Token': SHOPIFY_STOREFRONT_ACCESS_TOKEN }
      )
      return response.cartLinesUpdate.cart
    } catch (error) {
      console.error('Error updating cart item:', error)
      throw error
    }
  },

  async initiateCheckout(lineItems) {
    try {
      const response = await request(
        SHOPIFY_STOREFRONT_API_URL,
        CHECKOUT_CREATE_MUTATION,
        { 
          input: { 
            lineItems: lineItems.map(item => ({
              variantId: item.variantId,
              quantity: item.quantity
            }))
          } 
        },
        { 'X-Shopify-Storefront-Access-Token': SHOPIFY_STOREFRONT_ACCESS_TOKEN }
      )
      
      const checkout = response.checkoutCreate.checkout
      if (checkout.webUrl) {
        window.location.href = checkout.webUrl
      }
      
      return checkout
    } catch (error) {
      console.error('Error creating checkout:', error)
      throw error
    }
  }
}

// Updated Pinia Store (cartStore.js)
import { defineStore } from 'pinia'
import { shopifyClient } from '@/services/shopifyClient'

export const useCartStore = defineStore('cart', {
  state: () => ({
    cart: null,
    cartId: null,
    cartLoading: false,
    cartError: null,
    items: JSON.parse(localStorage.getItem('cart') || '[]')
  }),

  getters: {
    totalItems: (state) => state.items.reduce((acc, item) => acc + item.quantity, 0),
    totalPrice: (state) => state.items.reduce((acc, item) => acc + item.price * item.quantity, 0),
  },

  actions: {
    async initializeCart() {
      this.cartLoading = true
      try {
        const cart = await shopifyClient.createCart()
        this.cartId = cart.id
        this.cart = cart
      } catch (error) {
        this.cartError = error
      } finally {
        this.cartLoading = false
      }
    },

    async addToCart(product) {
      // Existing local cart logic
      const existingItem = this.items.find((item) => item.id === product.id)
      if (existingItem) {
        existingItem.quantity++
      } else {
        this.items.push({ ...product, quantity: 1 })
      }
      this.saveCart()

      // Shopify cart sync
      if (!this.cartId) await this.initializeCart()
      
      try {
        const variantId = product.variants[0]?.id || product.id
        const updatedCart = await shopifyClient.addToCart(this.cartId, variantId)
        this.cart = updatedCart
      } catch (error) {
        console.error('Failed to add to Shopify cart:', error)
      }
    },

    async removeFromCart(id) {
      // Find the line item in Shopify cart to remove
      const lineItemToRemove = this.cart?.lines.edges.find(
        edge => edge.node.merchandise.id === id
      )

      // Local cart removal
      this.items = this.items.filter((item) => item.id !== id)
      this.saveCart()

      // Shopify cart removal
      if (lineItemToRemove) {
        try {
          const updatedCart = await shopifyClient.removeFromCart(
            this.cartId, 
            lineItemToRemove.node.id
          )
          this.cart = updatedCart
        } catch (error) {
          console.error('Failed to remove from Shopify cart:', error)
        }
      }
    },

    async updateQuantity(id, quantity) {
      // Find the line item in Shopify cart to update
      const lineItemToUpdate = this.cart?.lines.edges.find(
        edge => edge.node.merchandise.id === id
      )

      // Local cart update
      const item = this.items.find((item) => item.id === id)
      if (item) {
        item.quantity = quantity
        if (item.quantity <= 0) {
          this.removeFromCart(id)
        }
      }
      this.saveCart()

      // Shopify cart update
      if (lineItemToUpdate) {
        try {
          const updatedCart = await shopifyClient.updateCartItemQuantity(
            this.cartId, 
            lineItemToUpdate.node.id, 
            quantity
          )
          this.cart = updatedCart
        } catch (error) {
          console.error('Failed to update Shopify cart:', error)
        }
      }
    },

    saveCart() {
      localStorage.setItem('cart', JSON.stringify(this.items))
    },

    async checkout() {
      // Prepare line items for checkout
      const lineItems = this.items.map(item => ({
        variantId: item.variants?.[0]?.id || item.id,
        quantity: item.quantity
      }))

      try {
        await shopifyClient.initiateCheckout(lineItems)
      } catch (error) {
        console.error('Checkout failed:', error)
      }
    }
  }
})

